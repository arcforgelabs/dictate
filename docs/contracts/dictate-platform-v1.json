{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.arcforge.au/dictate-platform/v1",
  "contract": {
    "name": "dictate-platform",
    "version": "v1",
    "schema_version": "1.0.0",
    "authority": "docs/goal.md",
    "status": "phase_0_draft_not_deployed",
    "owner_confirmation": "pending",
    "deployment_verification": "unknown",
    "implementation_claim": "This is a Dictate-side planning and handoff artifact. No shared backend or live service is claimed to conform."
  },
  "identity": {
    "subject_claim": "account_id",
    "subject_type": "Arc Forge account",
    "account_boundary": "account_id",
    "product": "dictate",
    "product_name": "Dictate",
    "entitlement": "dictate_pro",
    "entitlement_name": "Dictate Pro",
    "entitlement_role": "paid offering, plan, entitlement, and capability set; not an account identity",
    "capabilities": [
      "dictate.transcribe",
      "dictate.transcribe_diarized",
      "dictate.sync",
      "dictate.devices.manage",
      "dictate.account.manage"
    ],
    "local_mode_account_free": true,
    "separation_rule": "Dictate is the product and product space. Dictate Pro is its paid offering and entitlement. Arc Forge owns the account identity."
  },
  "surfaces": {
    "canonical_future_production": {
      "status": "proposed_not_deployed",
      "owner_confirmation": "pending",
      "deployment_verification": "unknown",
      "origin": {
        "scheme": "https",
        "url_template": "https://{canonical_arc_forge_origin}",
        "advertised_endpoint_scheme": "https",
        "requires_owner_confirmation": true
      },
      "operations_ref": "#/operations"
    },
    "current_api_compatibility": {
      "status": "current_source_compatibility",
      "production_authority": false,
      "canonical_for_production": false,
      "deployment_verification": "unknown",
      "client_source": "src/dictate/pro/client.py",
      "default_base_url": "https://console.arcforge.au",
      "non_loopback_gateway": {
        "path_prefix": "/api",
        "selection_rule": "A non-loopback base URL selects the current Arc Forge gateway compatibility paths."
      },
      "explicit_modes": {
        "arcforge_gateway_hosted": {
          "mode_values": ["arcforge", "gateway", "hosted"],
          "path_prefix": "/api"
        },
        "local_or_legacy": {
          "mode_values": ["local", "legacy"],
          "path_prefix": "/v1"
        }
      },
      "released_client_counts": {
        "status": "unknown",
        "claimed": false,
        "evidence_required_before_claim": true
      }
    },
    "current_v1_reference": {
      "status": "test_reference_only",
      "label": "local or explicitly selected legacy /v1 compatibility; not a production authority",
      "production_authority": false,
      "canonical_for_production": false,
      "base_path": "/v1",
      "transport": "local/reference server or explicit legacy mode",
      "implementation": "src/dictate/pro/server.py",
      "allowed_use": "local tests, reference behavior, and bounded migration compatibility only",
      "released_client_counts": {
        "status": "unknown",
        "claimed": false
      }
    }
  },
  "operations": {
    "account.discovery": {
      "operation_id": "account.discovery",
      "method": "GET",
      "route": "/api/account/auth/desktop",
      "url_template": "https://{canonical_arc_forge_origin}/api/account/auth/desktop",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["account.discovery"],
      "request_schema": "#/schemas/EmptyRequest",
      "response_schema": "#/schemas/DiscoveryDocument",
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "pre_auth_discovery"
    },
    "account.login_authorize": {
      "operation_id": "account.login_authorize",
      "method": "GET",
      "route": "/api/account/auth/authorize",
      "url_template": "https://{canonical_arc_forge_origin}/api/account/auth/authorize",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["account.login"],
      "request_schema": "#/schemas/AuthorizationRequest",
      "response_schema": "#/schemas/AuthorizationResponse",
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "browser_session_and_pkce"
    },
    "account.token": {
      "operation_id": "account.token",
      "method": "POST",
      "route": "/api/account/auth/token",
      "url_template": "https://{canonical_arc_forge_origin}/api/account/auth/token",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["account.token_exchange"],
      "grant_modes": ["authorization_code_pkce", "refresh_token"],
      "covers": ["token_exchange", "refresh"],
      "request_schema": "#/schemas/TokenRequest",
      "response_schema": "#/schemas/TokenResponse",
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_grant"},
      "account_scope": "account_id_subject_after_grant"
    },
    "account.device_authorize": {
      "operation_id": "account.device_authorize",
      "method": "POST",
      "route": "/api/account/auth/device-code",
      "url_template": "https://{canonical_arc_forge_origin}/api/account/auth/device-code",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["account.device_authorization"],
      "request_schema": "#/schemas/DeviceAuthorizationRequest",
      "response_schema": "#/schemas/DeviceAuthorizationResponse",
      "state_refs": ["#/enums/auth_grant_state"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "client_and_pending_grant"},
      "account_scope": "pre_auth_client_bound"
    },
    "entitlement.read": {
      "operation_id": "entitlement.read",
      "method": "GET",
      "route": "/api/dictate/entitlement",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/entitlement",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.account.manage"],
      "request_schema": "#/schemas/EmptyRequest",
      "response_schema": "#/schemas/Entitlement",
      "state_refs": ["#/enums/entitlement_state"],
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "account_id"
    },
    "commerce.read": {
      "operation_id": "commerce.read",
      "method": "GET",
      "route": "/api/account/commerce?product=dictate",
      "url_template": "https://{canonical_arc_forge_origin}/api/account/commerce?product=dictate",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.account.manage"],
      "request_schema": "#/schemas/EmptyRequest",
      "response_schema": "#/schemas/CommerceSubscription",
      "state_refs": ["#/enums/commerce_state"],
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "account_id"
    },
    "device.register": {
      "operation_id": "device.register",
      "method": "POST",
      "route": "/api/dictate/devices",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/devices",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.devices.manage"],
      "request_schema": "#/schemas/DeviceRegistrationRequest",
      "response_schema": "#/schemas/Device",
      "state_refs": ["#/enums/device_state"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_device"},
      "account_scope": "account_id"
    },
    "device.list": {
      "operation_id": "device.list",
      "method": "GET",
      "route": "/api/dictate/devices",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/devices",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.devices.manage"],
      "request_schema": "#/schemas/EmptyRequest",
      "response_schema": "#/schemas/DeviceList",
      "state_refs": ["#/enums/device_state"],
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "account_id"
    },
    "device.revoke": {
      "operation_id": "device.revoke",
      "method": "POST",
      "route": "/api/dictate/devices/{device_id}/revoke",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/devices/{device_id}/revoke",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.devices.manage"],
      "request_schema": "#/schemas/DeviceActionRequest",
      "response_schema": "#/schemas/Device",
      "state_refs": ["#/enums/device_state"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_device"},
      "account_scope": "account_id"
    },
    "device.approve": {
      "operation_id": "device.approve",
      "method": "POST",
      "route": "/api/dictate/devices/{device_id}/approve",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/devices/{device_id}/approve",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.devices.manage"],
      "request_schema": "#/schemas/DeviceActionRequest",
      "response_schema": "#/schemas/Device",
      "state_refs": ["#/enums/device_state"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_device"},
      "account_scope": "account_id"
    },
    "sync.push": {
      "operation_id": "sync.push",
      "method": "POST",
      "route": "/api/dictate/sync",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/sync",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.sync"],
      "request_schema": "#/schemas/SyncPushRequest",
      "response_schema": "#/schemas/SyncPushResponse",
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_record"},
      "account_scope": "account_id"
    },
    "sync.pull": {
      "operation_id": "sync.pull",
      "method": "GET",
      "route": "/api/dictate/sync",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/sync",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.sync"],
      "request_schema": "#/schemas/SyncPullRequest",
      "response_schema": "#/schemas/SyncPullResponse",
      "state_refs": ["#/enums/sync_state"],
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "account_id"
    },
    "sync.cursor": {
      "operation_id": "sync.cursor",
      "method": "POST",
      "route": "/api/dictate/sync/cursor",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/sync/cursor",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.sync"],
      "request_schema": "#/schemas/SyncCursorRequest",
      "response_schema": "#/schemas/SyncCursorResponse",
      "state_refs": ["#/enums/sync_state"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_device"},
      "account_scope": "account_id"
    },
    "sync.key_envelopes.write": {
      "operation_id": "sync.key_envelopes.write",
      "method": "POST",
      "route": "/api/dictate/sync/key-envelopes",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/sync/key-envelopes",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.sync"],
      "request_schema": "#/schemas/KeyEnvelopeRequest",
      "response_schema": "#/schemas/KeyEnvelope",
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_envelope"},
      "account_scope": "account_id"
    },
    "sync.key_envelopes.read": {
      "operation_id": "sync.key_envelopes.read",
      "method": "GET",
      "route": "/api/dictate/sync/key-envelopes",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/sync/key-envelopes",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.sync"],
      "request_schema": "#/schemas/KeyEnvelopeQuery",
      "response_schema": "#/schemas/KeyEnvelopeList",
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "account_id"
    },
    "sync.export": {
      "operation_id": "sync.export",
      "method": "GET",
      "route": "/api/dictate/account/export",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/account/export",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.account.manage"],
      "request_schema": "#/schemas/EmptyRequest",
      "response_schema": "#/schemas/EncryptedExport",
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "account_id"
    },
    "sync.delete": {
      "operation_id": "sync.delete",
      "method": "DELETE",
      "route": "/api/dictate/account/cloud-data",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/account/cloud-data",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.account.manage"],
      "request_schema": "#/schemas/CloudDeleteRequest",
      "response_schema": "#/schemas/CloudDeleteResponse",
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account"},
      "account_scope": "account_id"
    },
    "hosted.create": {
      "operation_id": "hosted.create",
      "method": "POST",
      "route": "/api/dictate/jobs",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/jobs",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.transcribe", "dictate.transcribe_diarized"],
      "request_schema": "#/schemas/HostedCreateRequest",
      "response_schema": "#/schemas/HostedJob",
      "state_refs": ["#/enums/hosted_job_state", "#/enums/usage_event_lifecycle"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_request"},
      "account_scope": "account_id"
    },
    "hosted.upload": {
      "operation_id": "hosted.upload",
      "method": "POST",
      "route": "/api/dictate/jobs/{job_id}/upload",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/jobs/{job_id}/upload",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.transcribe", "dictate.transcribe_diarized"],
      "request_schema": "#/schemas/HostedUploadRequest",
      "response_schema": "#/schemas/HostedUpload",
      "state_refs": ["#/enums/hosted_upload_state", "#/enums/hosted_job_state"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_job"},
      "account_scope": "account_id"
    },
    "hosted.status": {
      "operation_id": "hosted.status",
      "method": "GET",
      "route": "/api/dictate/jobs/{job_id}",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/jobs/{job_id}",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.transcribe"],
      "request_schema": "#/schemas/HostedJobRequest",
      "response_schema": "#/schemas/HostedJob",
      "state_refs": ["#/enums/hosted_job_state"],
      "idempotency": {"required": false, "header": "not_applicable"},
      "account_scope": "account_id"
    },
    "hosted.result": {
      "operation_id": "hosted.result",
      "method": "GET",
      "route": "/api/dictate/jobs/{job_id}/result",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/jobs/{job_id}/result",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.transcribe"],
      "request_schema": "#/schemas/HostedJobRequest",
      "response_schema": "#/schemas/ResultArtifact",
      "state_refs": ["#/enums/hosted_job_state"],
      "idempotency": {"required": false, "header": "not_applicable", "replay": "same owner-bound artifact"},
      "account_scope": "account_id"
    },
    "hosted.ack": {
      "operation_id": "hosted.ack",
      "method": "POST",
      "route": "/api/dictate/jobs/{job_id}/result/ack",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/jobs/{job_id}/result/ack",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.transcribe"],
      "request_schema": "#/schemas/ResultAckRequest",
      "response_schema": "#/schemas/ResultAckResponse",
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_result"},
      "account_scope": "account_id"
    },
    "hosted.cancel": {
      "operation_id": "hosted.cancel",
      "method": "POST",
      "route": "/api/dictate/jobs/{job_id}/cancel",
      "url_template": "https://{canonical_arc_forge_origin}/api/dictate/jobs/{job_id}/cancel",
      "transport": "public_https",
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.transcribe"],
      "request_schema": "#/schemas/HostedJobRequest",
      "response_schema": "#/schemas/HostedJob",
      "state_refs": ["#/enums/hosted_job_state", "#/enums/usage_event_lifecycle"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_job"},
      "account_scope": "account_id"
    },
    "gateway.invoke": {
      "operation_id": "gateway.invoke",
      "method": "POST",
      "route": "internal://arc-forge-gateway/model/invoke",
      "transport": "internal_governed_gateway",
      "public_client_access": false,
      "status": "proposed_not_deployed",
      "capabilities": ["dictate.transcribe", "dictate.transcribe_diarized"],
      "request_schema": "#/schemas/GatewayInvocation",
      "response_schema": "#/schemas/GatewayResponse",
      "state_refs": ["#/enums/usage_event_lifecycle", "#/enums/usage_event_type"],
      "idempotency": {"required": true, "header": "Idempotency-Key", "scope": "account_and_request"},
      "account_scope": "account_id"
    }
  },
  "enums": {
    "auth_grant_state": {
      "type": "string",
      "enum": ["pending", "approved", "denied", "consumed", "expired"]
    },
    "commerce_state": {
      "type": "string",
      "enum": ["incomplete", "trialing", "active", "past_due", "canceled", "cancelled", "unpaid", "paused", "expired", "refunded"]
    },
    "entitlement_state": {
      "type": "string",
      "enum": ["active", "inactive", "grace", "past_due", "cancelled", "expired", "refunded", "revoked", "store_active"]
    },
    "device_state": {
      "type": "string",
      "enum": ["pending", "trusted", "revoked", "expired"]
    },
    "sync_state": {
      "type": "string",
      "enum": ["disabled", "pending", "enabled", "paused", "revoked", "deleted"]
    },
    "hosted_job_state": {
      "type": "string",
      "enum": ["created", "awaiting_upload", "uploaded", "queued", "processing", "completed", "failed", "cancelled", "expired", "quota_rejected"]
    },
    "hosted_upload_state": {
      "type": "string",
      "enum": ["awaiting_upload", "stored", "uploaded", "queued", "processing", "consumed", "failed", "expired"]
    },
    "usage_event_lifecycle": {
      "type": "string",
      "enum": ["reserved", "settled", "rolled_back", "rejected"]
    },
    "usage_event_type": {
      "type": "string",
      "enum": ["reservation", "settlement", "rollback", "rejection"]
    }
  },
  "schemas": {
    "EmptyRequest": {
      "type": "object",
      "additionalProperties": false
    },
    "AccountContext": {
      "type": "object",
      "required": ["account_id", "product"],
      "properties": {
        "account_id": {"type": "string", "minLength": 1},
        "product": {"const": "dictate"},
        "entitlement": {"const": "dictate_pro"}
      }
    },
    "DiscoveryDocument": {
      "type": "object",
      "required": ["issuer", "authorization_endpoint", "token_endpoint", "device_authorization_endpoint"],
      "properties": {
        "issuer": {"type": "string", "pattern": "^https://"},
        "authorization_endpoint": {"type": "string", "pattern": "^https://"},
        "token_endpoint": {"type": "string", "pattern": "^https://"},
        "device_authorization_endpoint": {"type": "string", "pattern": "^https://"},
        "grant_types_supported": {"type": "array", "items": {"type": "string"}},
        "code_challenge_methods_supported": {"type": "array", "items": {"const": "S256"}}
      }
    },
    "AuthorizationRequest": {
      "type": "object",
      "required": ["response_type", "client_id", "redirect_uri", "state", "code_challenge", "code_challenge_method"],
      "properties": {
        "response_type": {"const": "code"},
        "client_id": {"const": "dictate-desktop"},
        "redirect_uri": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|\\[::1\\])"},
        "state": {"type": "string"},
        "code_challenge": {"type": "string"},
        "code_challenge_method": {"const": "S256"}
      }
    },
    "AuthorizationResponse": {
      "type": "object",
      "required": ["code", "state"],
      "properties": {"code": {"type": "string"}, "state": {"type": "string"}}
    },
    "TokenRequest": {
      "type": "object",
      "required": ["grant_type"],
      "properties": {
        "grant_type": {"enum": ["authorization_code", "refresh_token", "urn:ietf:params:oauth:grant-type:device_code"]},
        "code": {"type": "string"},
        "code_verifier": {"type": "string"},
        "refresh_token": {"type": "string"},
        "device_code": {"type": "string"},
        "client_id": {"const": "dictate-desktop"}
      }
    },
    "TokenResponse": {
      "type": "object",
      "required": ["access_token", "refresh_token", "token_type", "expires_in", "account_id"],
      "properties": {
        "access_token": {"type": "string"},
        "refresh_token": {"type": "string"},
        "token_type": {"const": "Bearer"},
        "expires_in": {"type": "integer", "minimum": 1},
        "account_id": {"type": "string"},
        "device_id": {"type": "string"}
      }
    },
    "DeviceAuthorizationRequest": {
      "type": "object",
      "required": ["client_id"],
      "properties": {"client_id": {"const": "dictate-desktop"}, "scope": {"const": "dictate"}, "device_label": {"type": "string"}}
    },
    "DeviceAuthorizationResponse": {
      "type": "object",
      "required": ["device_code", "user_code", "verification_uri", "expires_in", "interval"],
      "properties": {
        "device_code": {"type": "string"},
        "user_code": {"type": "string"},
        "verification_uri": {"type": "string", "pattern": "^https://"},
        "verification_uri_complete": {"type": "string", "pattern": "^https://"},
        "expires_in": {"type": "integer", "minimum": 1},
        "interval": {"type": "integer", "minimum": 1},
        "state": {"$ref": "#/enums/auth_grant_state"}
      }
    },
    "Entitlement": {
      "type": "object",
      "required": ["account_id", "product", "entitlement", "state", "capabilities"],
      "properties": {
        "account_id": {"type": "string"},
        "product": {"const": "dictate"},
        "entitlement": {"const": "dictate_pro"},
        "state": {"$ref": "#/enums/entitlement_state"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "period": {"$ref": "#/schemas/UsagePeriod"}
      }
    },
    "CommerceSubscription": {
      "type": "object",
      "required": ["account_id", "product", "plan_id", "state"],
      "properties": {
        "account_id": {"type": "string"},
