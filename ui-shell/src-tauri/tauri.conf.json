{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dictate",
  "version": "2026.5.18-1",
  "identifier": "com.arcforgelabs.dictate",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Desktop dictation — the Quiet Console.",
    "longDescription": "Dictate types your speech straight into whatever app you're focused on. The frozen Python engine ships inside this package, so no separate install is needed; speech models download on first use.",
    "resources": ["engine/**/*"],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libasound2",
          "libportaudio2"
        ]
      }
    }
  }
}
